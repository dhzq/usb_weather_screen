CONFIG_ESP_TASK_WDT_EN=n
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096
CONFIG_BOARD_TYPE_HUB_RGB=y
CONFIG_LV_USE_LODEPNG=y
CONFIG_COMPILER_CXX_RTTI=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# fonts used by the UI pages (main/ui)
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_USE_FONT_COMPRESSED=y

# two SNTP servers (wifi_service.c)
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# LVGL heap: use malloc (PSRAM-backed) instead of the fixed 64 KB builtin pool, which the cached pages exhaust
CONFIG_LV_USE_CLIB_MALLOC=y

CONFIG_LV_FONT_MONTSERRAT_16=y

# app_main runs the whole bring-up (display, LVGL, WiFi, hub probe) on the main task
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
